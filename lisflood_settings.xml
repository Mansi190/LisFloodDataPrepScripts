<?xml version="1.0" encoding="UTF-8"?>
<!--
  LISFLOOD Settings — auto-generated by pipeline.py
  ROI : ./ShapeFile/ArariaShapefile.shp
  CRS : EPSG:32645  |  30 m

  TODO items are marked with [FILL IN] and must be set before running LISFLOOD.
  Calibration parameters marked [CALIBRATE] require a spin-up or parameter
  estimation procedure (e.g. PEST, DREAM, manual tuning against discharge gauges).
-->

<lfsettings>

  <!-- ══════════════════════════════════════════════════════════════
       SIMULATION CONTROL
  ═══════════════════════════════════════════════════════════════ -->
  <lfuser>

    <textvar name="CalendarDayStart" value="[FILL IN: e.g. 01/01/2024 06:00]"/>
    <textvar name="StepStart"        value="[FILL IN: e.g. 1]"/>
    <textvar name="StepEnd"          value="[FILL IN: e.g. 365]"/>
    <textvar name="DtSec"            value="86400"/>   <!-- daily timestep -->
    <textvar name="DtSecChannel"     value="3600"/>    <!-- sub-daily channel routing -->

    <textvar name="PathRoot"         value="."/>
    <textvar name="PathMaps"         value="./lisflood_outputs/maps"/>
    <textvar name="PathMeteo"        value="./lisflood_meteo/penman"/>
    <textvar name="PathOut"          value="./lisflood_run_output"/>

    <!-- ── Model switches ──────────────────────────────────────────── -->
    <textvar name="GroundwaterSmooth"        value="1"/>
    <textvar name="TransientGroundwaterFlow" value="1"/>
    <textvar name="SplitRouting"             value="1"/>
    <textvar name="ReportSteps"              value="1..365"/>

  </lfuser>

  <!-- ══════════════════════════════════════════════════════════════
       SPATIAL MAPS — TOPOGRAPHY
  ═══════════════════════════════════════════════════════════════ -->
  <textvar name="MaskMap"    value="./lisflood_outputs/maps/area.map"/>
  <textvar name="Dem"        value="./lisflood_outputs/maps/dem.map"/>
  <textvar name="Ldd"        value="./lisflood_outputs/maps/ldd.map"/>
  <textvar name="Grad"       value="./lisflood_outputs/maps/gradient.map"/>
  <textvar name="ElevStdev"  value="./lisflood_outputs/maps/elvstd.map"/>

  <!-- ══════════════════════════════════════════════════════════════
       SPATIAL MAPS — LAND USE / LAND COVER
  ═══════════════════════════════════════════════════════════════ -->
  <textvar name="FracWater"  value="./lisflood_lulc/maps/fracwater.map"/>
  <textvar name="FracSealed" value="./lisflood_lulc/maps/fracsealed.map"/>
  <textvar name="FracForest" value="./lisflood_lulc/maps/fracforest.map"/>
  <textvar name="FracOther"  value="./lisflood_lulc/maps/fracother.map"/>

  <textvar name="CropCoefForest"  value="./lisflood_lulc/maps/cropcoef_forest.map"/>
  <textvar name="CropCoefOther"   value="./lisflood_lulc/maps/cropcoef_other.map"/>
  <textvar name="CropGroupForest" value="./lisflood_lulc/maps/crgrnum_forest.map"/>
  <textvar name="CropGroupOther"  value="./lisflood_lulc/maps/crgrnum_other.map"/>

  <textvar name="Manning"        value="./lisflood_lulc/maps/mannings_forest.map"/>  <!-- forest -->
  <textvar name="ManningSoil"    value="./lisflood_lulc/maps/mannings_other.map"/>   <!-- other  -->

  <textvar name="SoilDepth1a"    value="./lisflood_lulc/maps/soildep1_forest.map"/>
  <textvar name="SoilDepth1b"    value="./lisflood_lulc/maps/soildep1_other.map"/>
  <textvar name="SoilDepth2a"    value="./lisflood_lulc/maps/soildep2_forest.map"/>
  <textvar name="SoilDepth2b"    value="./lisflood_lulc/maps/soildep2_other.map"/>

  <!-- ══════════════════════════════════════════════════════════════
       SPATIAL MAPS — SOIL HYDRAULIC PROPERTIES
  ═══════════════════════════════════════════════════════════════ -->
  <textvar name="ThetaSat1a"  value="./lisflood_soil/maps/thetas1_forest.nc"/>
  <textvar name="ThetaSat1b"  value="./lisflood_soil/maps/thetas1_other.nc"/>
  <textvar name="ThetaSat2"   value="./lisflood_soil/maps/thetas2.nc"/>

  <textvar name="ThetaRes1a"  value="./lisflood_soil/maps/thetar1_forest.nc"/>
  <textvar name="ThetaRes1b"  value="./lisflood_soil/maps/thetar1_other.nc"/>
  <textvar name="ThetaRes2"   value="./lisflood_soil/maps/thetar2.nc"/>

  <textvar name="GenuAlpha1a" value="./lisflood_soil/maps/alpha1_forest.nc"/>
  <textvar name="GenuAlpha1b" value="./lisflood_soil/maps/alpha1_other.nc"/>
  <textvar name="GenuAlpha2"  value="./lisflood_soil/maps/alpha2.nc"/>

  <textvar name="GenuLambda1a" value="./lisflood_soil/maps/lambda1_forest.nc"/>
  <textvar name="GenuLambda1b" value="./lisflood_soil/maps/lambda1_other.nc"/>
  <textvar name="GenuLambda2"  value="./lisflood_soil/maps/lambda2.nc"/>

  <textvar name="KSat1a"  value="./lisflood_soil/maps/ksat1_forest.nc"/>
  <textvar name="KSat1b"  value="./lisflood_soil/maps/ksat1_other.nc"/>
  <textvar name="KSat2"   value="./lisflood_soil/maps/ksat2.nc"/>

  <!-- ══════════════════════════════════════════════════════════════
       SPATIAL MAPS — CHANNEL GEOMETRY
  ═══════════════════════════════════════════════════════════════ -->
  <textvar name="Channels"           value="./lisflood_channels/maps/chan.nc"/>
  <textvar name="ChanGrad"           value="./lisflood_channels/maps/changrad.nc"/>
  <textvar name="ChanMan"            value="./lisflood_channels/maps/chanman.nc"/>
  <textvar name="ChanLength"         value="./lisflood_channels/maps/chanleng.nc"/>
  <textvar name="ChanBottomWidth"    value="./lisflood_channels/maps/chanbw.nc"/>
  <textvar name="ChanSdXdY"          value="./lisflood_channels/maps/chans.nc"/>
  <textvar name="ChanDepthThreshold" value="./lisflood_channels/maps/chanbnkf.nc"/>

  <!-- ══════════════════════════════════════════════════════════════
       SPATIAL MAPS — LAI (12 monthly files)
       LISFLOOD expects files named lai_forest_DDMMYYYY.map
  ═══════════════════════════════════════════════════════════════ -->
  <textvar name="LAIForest" value="./lai_outputs_landsat/maps/lai_forest_[DDMMYYYY].map"/>
  <textvar name="LAIOther"  value="./lai_outputs_landsat/maps/lai_other_[DDMMYYYY].map"/>

  <!-- ══════════════════════════════════════════════════════════════
       GAUGES AND MONITORING SITES
  ═══════════════════════════════════════════════════════════════ -->
  <textvar name="GaugesMap"  value="./lisflood_gauges/maps/gauges.map"/>
  <textvar name="SitesMap"   value="./lisflood_gauges/maps/sites.map"/>

  <!-- ══════════════════════════════════════════════════════════════
       METEOROLOGICAL FORCING (NetCDF stacks)
  ═══════════════════════════════════════════════════════════════ -->
  <textvar name="PrecipitationMaps"  value="./lisflood_meteo/penman/pr.nc"/>
  <textvar name="TavgMaps"           value="./lisflood_meteo/penman/ta.nc"/>
  <textvar name="ETRefMaps"          value="./lisflood_meteo/penman/et.nc"/>
  <textvar name="E0Maps"             value="./lisflood_meteo/penman/e.nc"/>
  <textvar name="ES0Maps"            value="./lisflood_meteo/penman/es.nc"/>

  <!-- ══════════════════════════════════════════════════════════════
       INITIAL CONDITIONS  [FILL IN or use warm-start state files]
       These CANNOT be auto-generated — they require either:
         a) A spin-up simulation (run LISFLOOD for 1-5 years with
            recycled meteorology, then save the end-state)
         b) Observed data (soil moisture from satellite, GW levels
            from wells, stream discharge from gauges)
  ═══════════════════════════════════════════════════════════════ -->
  <textvar name="init_luzMaps"   value="[FILL IN: initial upper zone storage (mm)]"/>
  <textvar name="init_lzMaps"    value="[FILL IN: initial lower zone storage (mm)]"/>
  <textvar name="init_dslrMaps"  value="[FILL IN: initial days-since-last-rain]"/>
  <textvar name="init_wMaps"     value="[FILL IN: initial soil moisture layer 1]"/>
  <textvar name="init_w2Maps"    value="[FILL IN: initial soil moisture layer 2]"/>
  <textvar name="init_TotalChanQMaps" value="[FILL IN: initial channel discharge]"/>

  <!-- ══════════════════════════════════════════════════════════════
       CALIBRATION PARAMETERS  [CALIBRATE against observed discharge]
       These require parameter estimation (PEST / DREAM / manual).
       Typical starting values given for Bihar/monsoon climate.
  ═══════════════════════════════════════════════════════════════ -->
  <textvar name="SnowMeltCoef"        value="[CALIBRATE: start 4.0 mm/°C/day]"/>
  <textvar name="b_Xinanjiang"        value="[CALIBRATE: start 0.2, range 0.01–2.0]"/>
  <textvar name="PowerPrefFlow"       value="[CALIBRATE: start 3.0]"/>
  <textvar name="UpperZoneTimeConstant" value="[CALIBRATE: start 10 days]"/>
  <textvar name="LowerZoneTimeConstant" value="[CALIBRATE: start 1000 days]"/>
  <textvar name="GwPercValue"         value="[CALIBRATE: deep percolation, mm/day]"/>
  <textvar name="GwLoss"              value="[CALIBRATE: 0 = no GW loss]"/>
  <textvar name="CalChanMan"          value="[CALIBRATE: Manning multiplier, start 1.0]"/>
  <textvar name="CalEvaporation"      value="[CALIBRATE: ET multiplier, start 1.0]"/>

  <!-- ══════════════════════════════════════════════════════════════
       MISSING SPATIAL INPUTS (not auto-generated — require data)
       Comment out sections for processes not present in your basin.
  ═══════════════════════════════════════════════════════════════ -->
  <!--
  <textvar name="LakeSites"       value="[OPTIONAL: lake/reservoir locations]"/>
  <textvar name="ReservoirSites"  value="[OPTIONAL: reservoir sites]"/>
  <textvar name="WaterUseMap"     value="[OPTIONAL: irrigation/withdrawal]"/>
  <textvar name="PumpingMap"      value="[OPTIONAL: groundwater pumping]"/>
  -->

</lfsettings>
