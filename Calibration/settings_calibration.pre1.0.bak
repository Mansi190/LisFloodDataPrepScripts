Root=/Users/mansi/Documents/LisFlood/LisFloodDataPrepScripts/Calibration
ForcingStart=1/1/2003 00:00  # Starting of Meteo Forcings Precipitation Evapotranspiration TAvg  
ForcingEnd=31/12/2019 00:00  # Ending of Meteo Forcings Precipitation Evapotranspiration TAvg  
SubsetMeteoData=0 
WarmupDays=365  # Number of days for the Warmup period of the Model  
MinQlength=4  # Catchments with streamflow records shorter than the number of years specifed by MinQlength in settings.txt will not be processed 
No_of_calibration_lists=1 # Number of lists of catchments to process in parallel. i.e. If one agrees 10 nodes for running the calibration, a maximum of 10 (or less depending on direct links between subcatchments) lists will be generated with the name CatchmentsToProcess_XX.txt and 10 will be the maximum number of jobs submitted at the same time.  
MaxPercArea=0.1  

[CSV]
Qgis=/Users/mansi/Documents/LisFlood/LisFloodDataPrepScripts/Calibration/Qgis.csv # File containing metadata of Stations available with observation
Qtss=/Users/mansi/Documents/LisFlood/LisFloodDataPrepScripts/Calibration/Qts.csv # Observed data

[Path]
Temp=%(Root)s/temp  
Result=%(Root)s/result  
Templates=%(Root)s/templates       
SubCatchmentPath=%(Root)s/catchments  
ParamRanges=%(Root)s/ParamRanges_LISFLOOD.csv   # Values range for parameters to calibrate   
CatchmentDataPath=/Users/mansi/Documents/LisFlood/LisFloodDataPrepScripts/inputs  # static maps for lisflood model (landuse wateruse area ldd etc)
MeteoData=/Users/mansi/Documents/LisFlood/LisFloodDataPrepScripts/inputs/meteo # path to netcdf forcing data
PCRHOME=/opt/homebrew/Caskroom/miniconda/base/envs/lisflood-pcraster/bin/ # path to pcraster binaries
PYTHONCMD=/opt/homebrew/Caskroom/miniconda/base/envs/lisflood-pcraster/bin/python # path to python executable  (in case of several versions)

[Templates]  
LISFLOODSettings=%(Root)s/templates/settings_LF.xml # Settings for Lisflood Model  
RunLISFLOOD=%(Root)s/templates/runLF_linux.sh  # Script for launching PreRun and Run of the model, for every parameters combination during genetic algorithm runs   

[DEAP]  
use_multiprocessing=1  # Flag for using multiprocessing, meaning running several lisflood runs on several cores (each using 1 core)  
ngen=16  # number of MAX generation to run  
mu=16  # initial population  
lambda_=32  # size of generation of offsprings 
